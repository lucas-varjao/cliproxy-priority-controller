# CLIProxyAPI server root. Do not include /v8/management or /v0/management.
CLIPROXY_URL=http://127.0.0.1:8317

# Optional when local Management API authentication is disabled.
CLIPROXY_MANAGEMENT_KEY=

# auto tries v8 first and falls back to the deprecated v0 API.
CLIPROXY_API_VERSION=auto

# Supported values: claude,codex
CLIPROXY_PROVIDERS=claude,codex

CLIPROXY_INTERVAL=5m
CLIPROXY_HTTP_TIMEOUT=30s

# Closest weekly reset gets 100, next distinct routing tier gets 99, and so on.
CLIPROXY_PRIORITY_MAX=100
CLIPROXY_PRIORITY_STEP=1

# off: observe the 5-hour window but keep weekly-reset-only routing.
# guardrail: place credentials at/above the threshold behind healthy credentials.
CLIPROXY_FIVE_HOUR_MODE=off
CLIPROXY_FIVE_HOUR_MAX_UTILIZATION=90

# Start with dry-run=true to validate both quota windows and the ordering.
CLIPROXY_DRY_RUN=true
CLIPROXY_ONCE=false
